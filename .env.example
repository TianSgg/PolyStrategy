# ═══════════════════════════════════════════════════════════════
# PolyStrategy 环境变量模板
# 复制为 .env 后填入实际值: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── 基础配置 ─────────────────────────────────────────────────
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ─── 前端 ────────────────────────────────────────────────────
FRONTEND_PORT=9097
FRONTEND_ORIGIN=http://localhost:9097

# ─── JWT 认证配置 ─────────────────────────────────────────────
# JWT 签名密钥 (生产环境必须更换为随机字符串)
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=<generate-a-random-secret>
# 登录态有效期 (天数)
AUTH_SESSION_DAYS=7
# Cookie 名称
AUTH_COOKIE_NAME=polystrategy_auth
# Cookie Secure 标志: 0=HTTP, 1=仅 HTTPS
AUTH_COOKIE_SECURE=0

# ─── 初始 Root 用户 ──────────────────────────────────────────
# 首次启动时如果 users 表为空，会自动创建此超级管理员
ROOT_USERNAME=root
ROOT_PASSWORD=<set-initial-root-password>

# ─── MySQL 数据库 ─────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_DATABASE=polystrategy

# ─── 加密密钥 ─────────────────────────────────────────────────
# 用于加密存储账户私钥和 Builder Secret (Fernet 对称加密)
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<generate-a-fernet-key>

# ─── Consul (注册中心) ─────────────────────────────────────────
CONSUL_HTTP_PORT=9099
CONSUL_HTTP_ADDR=http://localhost:9099
CONSUL_HTTP_TOKEN=<your-consul-token>
# 服务注册到 Consul 时使用的地址
# 本地开发: 127.0.0.1; Docker 部署: 容器 IP 或宿主机 IP
SERVICE_ADDRESS=127.0.0.1

# ─── Traefik (API 网关) ────────────────────────────────────────
TRAEFIK_ENTRY_PORT=8000
TRAEFIK_DASHBOARD_PORT=9098
TRAEFIK_DASHBOARD_USER=root
TRAEFIK_DASHBOARD_PASSWORD=<your-dashboard-password>

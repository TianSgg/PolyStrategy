#!/usr/bin/env bash
set -euo pipefail

# One-time VPS bootstrap. Run from the repo root after cloning.
#
# Required env:
#   SERVER_NAME=example.com or your VPS IP
# Optional env:
#   APP_DIR=/home/$USER/weathertaker
#   BACKEND_PORT=9091
#   NGINX_LISTEN=8081
#   PYTHON_BIN=python3.11

APP_DIR="${APP_DIR:-$PWD}"
APP_USER="${APP_USER:-$(id -un)}"
SERVER_NAME="${SERVER_NAME:?set SERVER_NAME to your domain or VPS IP}"
BACKEND_PORT="${BACKEND_PORT:-9091}"
NGINX_LISTEN="${NGINX_LISTEN:-8081}"
MIN_PYTHON_VERSION="${MIN_PYTHON_VERSION:-3.11}"
PYTHON_BIN="${PYTHON_BIN:-}"

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing command: $1" >&2
    exit 1
  }
}

python_satisfies_min_version() {
  "$1" - "$MIN_PYTHON_VERSION" <<'PY'
import sys

minimum = tuple(int(part) for part in sys.argv[1].split("."))
raise SystemExit(0 if sys.version_info[: len(minimum)] >= minimum else 1)
PY
}

run_privileged() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "missing command: sudo" >&2
    exit 1
  fi
}

install_python() {
  echo "Python $MIN_PYTHON_VERSION+ was not found; attempting to install python3.11..." >&2

  if command -v dnf >/dev/null 2>&1; then
    run_privileged dnf install -y python3.11 python3.11-pip
    return
  fi

  if command -v yum >/dev/null 2>&1; then
    run_privileged yum install -y python3.11 python3.11-pip
    return
  fi

  if command -v apt-get >/dev/null 2>&1; then
    run_privileged apt-get update
    run_privileged apt-get install -y python3.11 python3.11-venv
    return
  fi

  echo "No supported package manager found. Install Python $MIN_PYTHON_VERSION+ manually." >&2
  exit 1
}

find_python() {
  local candidate
  for candidate in python3.12 python3.11 python3; do
    if command -v "$candidate" >/dev/null 2>&1 && python_satisfies_min_version "$candidate"; then
      command -v "$candidate"
      return 0
    fi
  done
  return 1
}

select_python() {
  if [ -n "$PYTHON_BIN" ]; then
    if command -v "$PYTHON_BIN" >/dev/null 2>&1 && python_satisfies_min_version "$PYTHON_BIN"; then
      PYTHON_BIN="$(command -v "$PYTHON_BIN")"
      return
    fi

    install_python
    if command -v "$PYTHON_BIN" >/dev/null 2>&1 && python_satisfies_min_version "$PYTHON_BIN"; then
      PYTHON_BIN="$(command -v "$PYTHON_BIN")"
      return
    fi

    echo "PYTHON_BIN=$PYTHON_BIN is missing or older than Python $MIN_PYTHON_VERSION after install attempt" >&2
    exit 1
  fi

  if PYTHON_BIN="$(find_python)"; then
    return
  fi

  install_python
  if PYTHON_BIN="$(find_python)"; then
    return
  fi

  echo "Python $MIN_PYTHON_VERSION+ is required for backend/requirements.txt." >&2
  echo "Install Python $MIN_PYTHON_VERSION+ manually or rerun with PYTHON_BIN=/path/to/python3.11." >&2
  exit 1
}

ensure_backend_venv() {
  if [ -x backend/.venv/bin/python ]; then
    if python_satisfies_min_version backend/.venv/bin/python; then
      return
    fi
    echo "backend/.venv was created with Python older than $MIN_PYTHON_VERSION; recreating it." >&2
    rm -rf backend/.venv
  fi

  "$PYTHON_BIN" -m venv backend/.venv
}

install_backend_requirements() {
  backend/.venv/bin/python -m pip install --upgrade pip
  (
    cd backend
    .venv/bin/pip install -r requirements.txt
  )
}

select_python
need_cmd npm
need_cmd sudo

if ! command -v nginx >/dev/null 2>&1; then
  echo "nginx is not installed. Install it first, then rerun this script." >&2
  exit 1
fi

cd "$APP_DIR"

if [ ! -f backend/.env.prod ]; then
  echo "missing backend/.env.prod; create it before bootstrapping" >&2
  exit 1
fi

if grep -q '^PORT=' backend/.env.prod; then
  if ! grep -q "^PORT=$BACKEND_PORT$" backend/.env.prod; then
    echo "backend/.env.prod PORT must match BACKEND_PORT=$BACKEND_PORT" >&2
    exit 1
  fi
else
  printf '\nPORT=%s\n' "$BACKEND_PORT" >> backend/.env.prod
fi

ensure_backend_venv
install_backend_requirements

npm --prefix frontend ci
mkdir -p deploy/state

tmp_nginx="$(mktemp)"
sed \
  -e "s#<USER>#$APP_USER#g" \
  -e "s#<SERVER_NAME>#$SERVER_NAME#g" \
  -e "s#listen 8081;#listen $NGINX_LISTEN;#g" \
  -e "s#127.0.0.1:9091#127.0.0.1:$BACKEND_PORT#g" \
  -e "s#/home/$APP_USER/weathertaker#$APP_DIR#g" \
  deploy/nginx_prod.conf.example > "$tmp_nginx"
sudo install -m 0644 "$tmp_nginx" "/etc/nginx/weathertaker.conf"
rm -f "$tmp_nginx"

tmp_nginx_main_template="$(mktemp)"
cat > "$tmp_nginx_main_template" <<'NGINX_MAIN'
user <APP_USER>;
worker_processes auto;
error_log /var/log/nginx/weathertaker.error.log notice;
pid /run/weathertaker-nginx.pid;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/weathertaker.access.log main;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    types_hash_max_size 4096;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    include /etc/nginx/weathertaker.conf;
}
NGINX_MAIN
tmp_nginx_main="$(mktemp)"
sed -e "s#<APP_USER>#$APP_USER#g" "$tmp_nginx_main_template" > "$tmp_nginx_main"
sudo install -m 0644 "$tmp_nginx_main" "/etc/nginx/weathertaker-nginx.conf"
rm -f "$tmp_nginx_main_template"
rm -f "$tmp_nginx_main"

echo "Bootstrap done. Run deploy/deploy_prod.sh.example for the first build/restart."

# 前端构建时注入的后端地址（Vite 只识别 VITE_ 前缀变量）
# .env.development — npm run dev 时读取
# .env.production  — npm run build 时读取

# 开发环境
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# 生产环境，复制为 .env.production 后修改为你的 VPS IP 和端口（nginx 监听端口）
# VITE_API_BASE=http://YOUR_VPS_IP
# VITE_WS_BASE=ws://YOUR_VPS_IP
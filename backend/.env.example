LOG_LEVEL=INFO
APP_ENV=production
HOST=0.0.0.0
PORT=8081
ENCRYPTION_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# 前端地址，用于 CORS + Cookie 登录态
FRONTEND_ORIGIN=http://YOUR_VPS_IP

# 登录认证配置
# 生产环境必须设置 AUTH_JWT_SECRET，并建议使用 32+ 字节随机值：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=<generate with: python -c "import secrets; print(secrets.token_urlsafe(48))">
AUTH_SESSION_DAYS=7
AUTH_COOKIE_NAME=polystrategy_auth
# HTTPS 部署时设为 1；本地 http://localhost 开发保持 0
AUTH_COOKIE_SECURE=0

# 首次启动且 users 表没有 root 时，会自动创建这个超级用户
ROOT_USERNAME=root
ROOT_PASSWORD=<set-initial-root-password>

PREDEXON_API_KEY=<your_key>

# Consul ACL Token（Consul 启用 ACL 后所有服务注册/发现需要此 token）
# 首次启动 Consul 后从 ACL bootstrap 获取，或使用 config.json 中的 initial_management token
CONSUL_HTTP_TOKEN=<your_consul_acl_token>

# Traefik Dashboard 密码（用于 basicAuth）
# 生成: htpasswd -nb admin your_password | sed 's/\$/\$\$/g'
# 注意：docker-compose 中 $ 需要转义为 $$
TRAEFIK_DASHBOARD_USER=admin:$$apr1$$xxxx$$REPLACE_WITH_HTPASSWD_OUTPUT

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=polystrategy
